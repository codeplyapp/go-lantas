rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.role == 'admin'
      );
    }

    // ─── 1. USER PROFILES & SUBCOLLECTIONS ──────────────────────────────────
    match /users/{uid} {
      // Authenticated users can read profiles for leaderboard, student search, and family pairing
      allow read: if isAuthenticated();
      // Only the user owner can create or update their own profile
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) && (
        !('poin_total' in request.resource.data) ||
        !('poin_total' in resource.data) ||
        (
          request.resource.data.poin_total >= resource.data.poin_total &&
          request.resource.data.poin_total - resource.data.poin_total <= 200
        )
      );
      allow delete: if isOwner(uid) || isAdmin();

      // Subcollection module_progress: only owner can read/write
      match /module_progress/{moduleId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ─── 2. USER PROGRESS & ATTEMPTS ─────────────────────────────────────────
    // Quiz attempts: read authenticated, create by owner (request.resource.data.uid), update/delete by owner (resource.data.uid)
    match /quiz_attempts/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    // Exam attempts: read by owner/admin, create by owner
    match /exam_attempts/{docId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    // Root-level module progress (if used alongside subcollections)
    match /module_progress/{docId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    // Certificates issued to users
    match /certificates/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    // Personal notification schedules
    match /notification_schedules/{docId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    // ─── 3. CROSS-USER SENSITIVE DATA (FAMILY & SOS) ────────────────────────
    // Family pairing & consent links (PDP Law compliance)
    match /family_links/{docId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.parent_uid == request.auth.uid || 
        resource.data.child_uid == request.auth.uid ||
        resource.data.pairing_code != null
      );
      allow create: if isAuthenticated() && (
        request.resource.data.parent_uid == request.auth.uid || 
        request.resource.data.child_uid == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.parent_uid == request.auth.uid || 
        resource.data.child_uid == request.auth.uid ||
        isAdmin()
      );
    }

    // Family access audit logs (Immutable for audit trail)
    match /family_logs/{docId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.accessor_uid == request.auth.uid || 
        resource.data.target_uid == request.auth.uid ||
        resource.data.parent_uid == request.auth.uid || 
        resource.data.child_uid == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.accessor_uid == request.auth.uid || 
        request.resource.data.parent_uid == request.auth.uid
      );
      allow update, delete: if false; // Immutable audit log
    }

    // SOS Emergency Alerts
    match /sos_alerts/{docId} {
      // SOS broadcasts readable by authenticated family & emergency dispatchers
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ─── 4. PUBLIC CURATED CONTENT (READ FOR AUTH USERS, WRITE FOR ADMIN) ──
    match /modules/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /videos/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /schools/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /facilities/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /incidents/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /quiz_bank/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /quiz_questions/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
